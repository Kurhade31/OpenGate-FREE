---
import Base from '../../../layouts/Base.astro';
---
<Base title="Mock analyser" description="Paste mock question-wise results to get score, accuracy, topic and time analysis. Clearly labels platform-original vs official." canonicalPath="/tools/mock-analyzer/">
  <section class="hero"><div class="wrap"><p class="kicker">Tool · platform-original vs official</p><h1>Mock analyser</h1><p class="lead">Paste one line per question: <code>topic, correct(1/0), marks, seconds</code>. Get score, accuracy and topic gaps. Unofficial mocks are always labelled <strong>platform-original</strong> — never official.</p></div></section>
  <section class="section"><div class="wrap grid cols-2">
    <div class="card"><div class="form-grid"><label>Results (CSV lines)<textarea id="csv" rows="8" placeholder="OS,1,1,75&#10;DBMS,0,2,150&#10;CN,1,1,60"></textarea></label><button class="btn primary" id="analyze">Analyse</button><p class="meta" id="merr"></p></div></div>
    <div class="card"><h3>Result</h3><div id="mout"><div class="empty">No analysis yet.</div></div></div>
  </div></section>
</Base>
<script>
  document.getElementById('analyze')?.addEventListener('click', () => {
    const err = document.getElementById('merr');
    const out = document.getElementById('mout');
    err.textContent = '';
    try {
      const lines = document.getElementById('csv').value.split('\n').map((l) => l.trim()).filter(Boolean);
      if (!lines.length) throw new Error('Paste at least one line.');
      let score = 0, max = 0, correct = 0, time = 0;
      const byTopic = {};
      for (const ln of lines) {
        const [topic, c, m, s] = ln.split(',').map((x) => x.trim());
        if (!topic || (c !== '0' && c !== '1') || isNaN(Number(m))) throw new Error(`Bad line: ${ln}`);
        const marks = Number(m), secs = Number(s || 0);
        max += marks; time += secs;
        if (c === '1') { score += marks; correct++; }
        if (!byTopic[topic]) byTopic[topic] = { n: 0, ok: 0 };
        byTopic[topic].n++; if (c === '1') byTopic[topic].ok++;
      }
      const acc = Math.round((correct / lines.length) * 100);
      const rows = Object.entries(byTopic).map(([t, v]) => `<tr><td>${t}</td><td>${v.ok}/${v.n}</td><td>${Math.round((v.ok/v.n)*100)}%</td></tr>`).join('');
      out.innerHTML = `<p><strong>Score:</strong> ${score}/${max} · <strong>Accuracy:</strong> ${acc}% (${correct}/${lines.length}) · <strong>Time:</strong> ${Math.round(time/60)} min</p>
        <table><thead><tr><th>Topic</th><th>Correct</th><th>Rate</th></tr></thead><tbody>${rows}</tbody></table>
        <p class="meta">Next: revise the lowest-rate topic first; log each miss in the <a href="/tools/mistake-tracker/">mistake tracker</a>.</p>`;
    } catch (e) { err.textContent = e.message; }
  });
</script>
